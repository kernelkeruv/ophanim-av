#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="${OPHANIM_AV_APP_DIR:-$HOME/dev/OphanimAV}"
STATE_DIR="$HOME/.local/state/ophanim-av"

source "$APP_DIR/runtime-env.sh"

export \
    OPHANIM_AV_SOURCE \
    OPHANIM_AV_DERIVED \
    WHISPER_MODEL \
    YOLO_MODEL \
    YOLO_STRIDE \
    ENABLE_DIARIZATION \
    HF_TOKEN_FILE

export QT_QPA_PLATFORM=xcb

DATABASE="$OPHANIM_AV_DERIVED/catalog.sqlite3"

if [[ ! -f "$DATABASE" ]]; then
    printf 'ERROR: BODYCAM catalog does not exist:\n  %s\n' "$DATABASE" >&2
    exit 2
fi

mkdir -p "$STATE_DIR"

exec "$APP_DIR/.venv/bin/python" \
    "$APP_DIR/player.py" \
    "$@"
