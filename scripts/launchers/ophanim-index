#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="${OPHANIM_AV_APP_DIR:-$HOME/dev/OphanimAV}"
STATE_DIR="$HOME/.local/state/ophanim-av"

source "$APP_DIR/runtime-env.sh"

export \
    OPHANIM_AV_SOURCE \
    OPHANIM_AV_DERIVED \
    WHISPER_MODEL \
    YOLO_MODEL \
    YOLO_STRIDE \
    ENABLE_DIARIZATION \
    HF_TOKEN_FILE

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

LOCK_FILE="$STATE_DIR/index.lock"

exec 9>"$LOCK_FILE"

if ! flock -n 9; then
    printf 'OphanimAV indexing is already running.\n'
    printf 'Use these commands instead:\n'
    printf '  ophanim-status\n'
    printf '  ophanim-log\n'
    exit 0
fi

exec "$APP_DIR/.venv/bin/python" \
    "$APP_DIR/ophanim_av.py" \
    --source "$OPHANIM_AV_SOURCE" \
    --derived "$OPHANIM_AV_DERIVED" \
    "$@"
