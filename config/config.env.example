OPHANIM_AV_SOURCE=/path/to/media
OPHANIM_AV_DERIVED=/path/to/ophanim-av-derived
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8_float16
YOLO_MODEL=auto
YOLO_STRIDE=10
ENABLE_DIARIZATION=0
HF_TOKEN_FILE=$HOME/.config/ophanim-av/hf_token

# Hardware-aware YOLO26
OPHANIM_YOLO_POLICY=accuracy
YOLO_IMGSZ=640
YOLO_FP16=1
YOLO_CHANNELS_LAST=1
